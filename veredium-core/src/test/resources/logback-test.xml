<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Test output only: the SLF4J key-value pairs (%kvp, NONE = unquoted values) and the MDC
         (%mdc, only the keys that are present) are rendered next to the message, so a test log
         line shows everything an event carries, not just its text. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg %kvp{NONE} [%mdc]%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
