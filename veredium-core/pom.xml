<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>veredium</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>veredium-core</artifactId>
    <name>veredium-core</name>
    <!--
        The stack-neutral core both client modules build on: the mesh timeout ladder (app.mesh), the breaker verdicts
        (benign 4xx, client-side failure) and the Resilience4j wiring that installs them (per-alias customizers, the
        fail-fast startup guard). Nothing in here knows an HTTP stack - no RestClient, no WebClient, no transport -
        which is what lets veredium-restclient and veredium-webclient share it instead of carrying a copy each
        (docs/adr/ADR-0001-one-stack-neutral-core-module.md).
    -->
    <description>Veredium core: the mesh timeout ladder, the breaker verdicts and the Resilience4j wiring shared by both client stacks</description>
    <!-- Explicit, so the published POM carries the homepage itself. -->
    <url>https://github.com/Inqudium/veredium</url>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <!-- The Boot context: @ConfigurationProperties binding, @Configuration, the BeanRegistrar, ApplicationReadyEvent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- The Spring Boot 4 auto-configuration of the three Resilience4j registries the customizers and the guard
             attach to: the *ConfigCustomizer extension point and the bound resilience4j.* property beans. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- The Bean Validation API, for ResponseValidation: the one Validator both clients derive from the host's
             factory. The API only - a provider (hibernate-validator) is the host's, which the client starters bring. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- DistributionSummary, the response-size sample ClientCallLog records per call. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- The caller's current observation, which BlockingResilienceDecorator reopens on its worker thread. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JUnit 5, AssertJ and the Boot test support, like the sibling projects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A Bean Validation provider, TEST ONLY: ResponseValidationTest pins the English message interpolation
             against a real validator. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Once this module carries Jazzer @FuzzTest targets (Java sources under src/test/java,
                 CONTRIBUTING.md "Fuzzing"): declare the build-helper-maven-plugin here (managed in
                 the parent) and add the jazzer-junit test dependency (version managed there too). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- The module page Dokka renders on the API-reference index; version,
                 sourceLinks and failOnWarning come from the parent's pluginManagement.
                 No executions: dokka:dokka is invoked on demand by the Docs workflow. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>${project.basedir}/docs/api-module.md</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
