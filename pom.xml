<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>eu.inqudium</groupId>
    <artifactId>veredium</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>veredium</name>
    <description>
        Veredium - a web client implementation, named after the veredus, the post-horse of the
        Roman cursus publicus: the mount that carries the envoy to the foreign party and back.
    </description>
    <!-- Maven appends the module's artifactId to an INHERITED url and scm (Inqudium/veredium/veredium-core),
         which Central then shows as a homepage that does not exist; the attribute on <project> above and the ones on
         <scm> below switch that off for every module. -->
    <url>https://github.com/Inqudium/veredium</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>dirkjink</id>
            <name>Dirk Haase</name>
            <email>veredium@inqudium.eu</email>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/Inqudium/veredium.git</connection>
        <developerConnection>scm:git:git@github.com:Inqudium/veredium.git</developerConnection>
        <url>https://github.com/Inqudium/veredium</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Inqudium/veredium/issues</url>
    </issueManagement>

    <!--
        Default deploy target: the GitHub Packages Maven registry, used by
        the Release workflow's publish job (authenticated with the workflow
        token via a server entry with id "github"). Maven Central remains
        the primary release path and is deliberately separate: activate the
        release profile (-Prelease), which signs and uploads through the
        Central Portal instead.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Inqudium/veredium</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>veredium-core</module>
        <!-- Build-only: the test helpers the client modules share, never published (see its pom). -->
        <module>veredium-test-support</module>
        <module>veredium-restclient</module>
        <module>veredium-webclient</module>
        <!-- Build-only: usage examples of both clients, run by their tests, never published (see its pom). -->
        <module>veredium-examples</module>
        <!-- Build-only: the cross-module coverage report, never published (see its pom). -->
        <module>veredium-coverage</module>
    </modules>

    <properties>
        <!-- CI-Friendly Version -->
        <revision>1.0.1-SNAPSHOT</revision>

        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Java Version (Managed by Spring Boot Parent) -->
        <java.version>21</java.version>

        <!-- Kotlin Version (Override Spring Boot default) -->
        <kotlin.version>2.4.21</kotlin.version>

        <!--
            Reproducible builds (https://maven.apache.org/guides/mini/guide-reproducible-builds.html):
            with this property set, the Maven archivers (jar, source) write
            this instant as every zip entry's timestamp, sort the entries,
            normalize entry permissions and stop writing the build user, JDK
            and Maven versions into the manifest's Created-By, so the same
            source and version produce the same bytes on any machine. The
            jars the Release workflow attaches to the GitHub release (and
            attests with SLSA provenance) are then byte-identical to the ones
            deployed to Maven Central from a local checkout of the tag.
            Bumped in every release commit to the release date - the value
            only has to change per release, never per build.
        -->
        <project.build.outputTimestamp>2026-10-24T00:00:00Z</project.build.outputTimestamp>

        <!-- Third Party Dependencies -->
        <!-- Jackson 3 above the Spring Boot 4.1.1 BOM's 3.1.5: 3.1.7 fixes the OSV findings against
             jackson-core/-databind 3.1.5 (GHSA-7hhh-6rmp-j9qf, GHSA-p6pp-m3f8-5c89, GHSA-cxp5-3px4-pw24,
             GHSA-gx83-3vf8-gh7j, GHSA-q4xh-88c3-wmh7, GHSA-wjgm-6hv5-3cvf, GHSA-wv8q-qhhj-9h54). Remove the
             override once a Boot release manages >= 3.1.7 itself. -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <!-- Fuzzing (test scope): Jazzer's JUnit 5 integration - @FuzzTest
             methods run as regression tests in every verify and fuzz for
             real in the scheduled Fuzz workflow (JAZZER_FUZZ=1). -->
        <jazzer.version>0.30.0</jazzer.version>
        <!-- Resilience4j: the BOM below aligns every resilience4j-* artifact; the Boot 4 starter is managed
             explicitly because the BOM of this version does not list it. -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- eu.inqudium legatium: outbound HTTP exchange logging, one twin per client stack. One property, so both
             modules carry the same version; there is no BOM. -->
        <legatium.version>1.3.0</legatium.version>
        <!-- WireMock (test scope of both client modules). -->
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Plugin Versions -->
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <ktlint-maven-plugin.version>3.7.1</ktlint-maven-plugin.version>
        <dokka-maven-plugin.version>2.2.0</dokka-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <versions-maven-plugin.version>2.23.0</versions-maven-plugin.version>

        <!--
            Default for the late-bound @{argLine} reference in the Surefire
            configuration: JaCoCo's prepare-agent goal overwrites this
            property with its -javaagent argument. The empty default keeps
            Surefire working when JaCoCo is skipped (-Djacoco.skip=true).
        -->
        <argLine></argLine>

        <!--
            Extra test-JVM flags, empty by default: the jdk-24-plus profile
            below fills them so a modern JDK (CI runs 25, see the workflows)
            does not spam Unsafe/native-access warnings, while an older build
            JDK would reject the flags and therefore never sees them.
        -->
        <surefire.jvmCompatArgs></surefire.jvmCompatArgs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.code-intelligence</groupId>
                <artifactId>jazzer-junit</artifactId>
                <version>${jazzer.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Kotlin stdlib for all modules; kotlin-reflect is what @ConfigurationProperties
             binding of Kotlin classes needs at runtime. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Flatten Plugin (resolves the CI-friendly ${revision} for install/deploy) -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                        <outputDirectory>${project.build.directory}</outputDirectory>
                        <flattenedPomFilename>.flattened-pom.xml</flattenedPomFilename>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Kotlin Compiler: the spring compiler plugin (all-open) is load-bearing -
                     without it the @AutoConfiguration/@Configuration classes compile final. -->
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <configuration>
                        <jvmTarget>${java.version}</jvmTarget>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                            <arg>-Xannotation-default-target=param-property</arg>
                        </args>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                        </compilerPlugins>
                    </configuration>
                    <dependencies>
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!-- Surefire: also pick up Kotlin test classes -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Test.kt</include>
                        </includes>
                    </configuration>
                </plugin>

                <!--
                    KDoc API reference, generated on demand with
                    `mvn -pl <modules> dokka:dokka` (not bound to the default
                    lifecycle to keep `mvn verify` fast; per module, because the
                    Dokka Maven plugin has no aggregate mode). The Docs workflow
                    publishes each module's output under /api/<module>/ on the
                    documentation site. The module page rendered on the index
                    (docs/api-module.md) is declared in each module's pom, not
                    here - the parent has no such file, and its release-profile
                    javadocJar run must not require one.
                -->
                <plugin>
                    <groupId>org.jetbrains.dokka</groupId>
                    <artifactId>dokka-maven-plugin</artifactId>
                    <version>${dokka-maven-plugin.version}</version>
                    <configuration>
                        <moduleName>${project.artifactId}</moduleName>
                        <outputDir>${project.build.directory}/dokka</outputDir>
                        <!-- Fail on unresolved [Symbol] references (and other
                             Dokka warnings): KDoc links are only trustworthy
                             carriers when a red build guards them.
                             reportUndocumented stays off, so only genuine
                             reference/markup problems gate. -->
                        <failOnWarning>true</failOnWarning>
                        <sourceLinks>
                            <link>
                                <path>src/main/kotlin</path>
                                <url>https://github.com/Inqudium/veredium/tree/main/${project.artifactId}/src/main/kotlin</url>
                                <lineSuffix>#L</lineSuffix>
                            </link>
                        </sourceLinks>
                        <!--
                            Workaround: DO NOT DELETE, even though the IDE flags
                            this element as illegal - pluginsConfiguration is not a
                            declared Mojo parameter — the Dokka Maven plugin
                            reads it out-of-band from the raw configuration
                            XML (verified against dokka-maven-plugin 2.2.0;
                            the custom logo demonstrably lands in the output).

                            logo-icon.svg is the magic asset name: it replaces
                            Dokka's default header logo AND the favicon (the
                            generated pages link images/logo-icon.svg as icon).
                            The file is a copy of docs/logo/veredium-icon.svg.
                            The ../ hop reaches the repo root from the module
                            directory; Dokka only runs on the child modules
                            (-pl), never on this aggregator.
                        -->
                        <pluginsConfiguration>
                            <org.jetbrains.dokka.base.DokkaBase>
                                <customAssets>
                                    <asset>${project.basedir}/../docs/logo/logo-icon.svg</asset>
                                </customAssets>
                            </org.jetbrains.dokka.base.DokkaBase>
                        </pluginsConfiguration>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>com.github.gantsign.maven</groupId>
                    <artifactId>ktlint-maven-plugin</artifactId>
                    <version>${ktlint-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!-- No sourceRoots configuration: the parameter is read-only in this
                         plugin version (it warned and was ignored); the defaults already
                         cover the compile and test source roots. -->
                </plugin>

                <!-- The fuzz tests are JAVA sources (the OpenSSF Scorecard fuzzing
                     detector recognizes Jazzer only in *.java files), while
                     testSourceDirectory points at src/test/kotlin - this adds
                     src/test/java back as a second test-source root. Managed
                     here, DECLARED only by the modules that have such sources -
                     on the others it would only warn about a missing source root. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.6.2</version>
                    <executions>
                        <execution>
                            <id>add-java-fuzz-test-sources</id>
                            <phase>generate-test-sources</phase>
                            <goals>
                                <goal>add-test-source</goal>
                            </goals>
                            <configuration>
                                <sources>
                                    <source>${project.basedir}/src/test/java</source>
                                </sources>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    No Created-By / Build-Jdk-Spec in the jar and sources
                    manifests: the latter names the JDK that ran the build (25
                    in CI, whatever 24+ a maintainer has locally) and would be
                    the one manifest line keeping two builds of the same tag
                    from being byte-identical - see project.build.outputTimestamp.
                    Versions and the Implementation-* entries come from the
                    Spring Boot parent's plugin management.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultEntries>false</addDefaultEntries>
                                <!-- Implementation-Title/-Version/-Vendor from the POM only - reproducible, unlike the
                                     default entries above - so Veredium.version reads the release from the jar and the
                                     User-Agent token both clients send becomes `veredium/<version>`. -->
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultEntries>false</addDefaultEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} is resolved LATE (after JaCoCo's prepare-agent
                         set the property), so the coverage agent and the JVM flags
                         combine instead of the literal argLine overriding the
                         agent. The compat property is filled by the jdk-24-plus
                         profile and stays empty on a pre-24 build JDK. -->
                    <argLine>
                        @{argLine}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        -XX:+EnableDynamicAgentLoading
                        ${surefire.jvmCompatArgs}
                    </argLine>
                </configuration>
            </plugin>

            <!--
                Test coverage, always on: the agent attaches via the argLine
                property (merged with the JVM flags in the Surefire config -
                see the @{argLine} note there) and each module's report is
                written at verify to target/site/jacoco/ (HTML + XML + CSV).
                veredium-coverage merges all of them into one cross-module
                report (target/site/jacoco-aggregate/), which the badge, the CI
                summary and the published /coverage/ page read, so the visible
                numbers are generated, never hand-maintained. Skip locally with
                -Djacoco.skip=true.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                CycloneDX SBOM of the RESOLVED dependency graph, generated on
                demand with `mvn cyclonedx:makeAggregateBom` (deliberately not
                bound to a lifecycle phase, so `mvn verify` stays fast). The CI
                dependency scan consumes the aggregated target/bom.json.

                Why an SBOM rather than scanning pom.xml directly: most versions
                here are managed by the Spring Boot BOM and therefore do not
                appear in pom.xml at all. Only the resolved graph states what
                actually ships - which is exactly what a vulnerability scan has
                to look at.

                Test-scoped dependencies are excluded (the plugin's default):
                they never reach a consumer, and an advisory in a test-only
                library should not gate the build.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <configuration>
                    <outputFormat>json</outputFormat>
                    <schemaVersion>1.6</schemaVersion>
                </configuration>
                <!-- cyclonedx-core-java >= 13 registers the CycloneDX schema's
                     meta:enum/deprecated annotation keywords with the JSON-schema
                     validator (NonValidationKeyword), silencing the two
                     "Unknown keyword" warnings the plugin's bundled 9.x emitted
                     on every BOM validation. Remove the override once the plugin
                     itself ships a >= 13 core. -->
                <dependencies>
                    <dependency>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-core-java</artifactId>
                        <version>13.2.0</version>
                    </dependency>
                    <!-- The plugin used commons-io transitively via the 9.x core;
                         the 13.x core no longer carries it. -->
                    <dependency>
                        <groupId>commons-io</groupId>
                        <artifactId>commons-io</artifactId>
                        <version>2.22.0</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.gantsign.maven</groupId>
                <artifactId>ktlint-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <!--
            JDK 24+ prints warnings when Jazzer's native agent and Netty touch
            sun.misc.Unsafe / restricted native methods from the test JVM, and
            the appended JaCoCo agent additionally triggers the CDS sharing
            warning. These flags acknowledge the accesses; they do not exist
            before JDK 23/24, hence the activation guard for older build JDKs
            (CI runs 25). The MAVEN JVM gets the same acknowledgements from
            .mvn/jvm.config - that silences the embedded Kotlin compiler's
            Unsafe warning during ktlint/dokka runs.
        -->
        <profile>
            <id>jdk-24-plus-test-jvm</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <properties>
                <surefire.jvmCompatArgs>--sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED -Xshare:off</surefire.jvmCompatArgs>
            </properties>
        </profile>

        <!-- Everything Maven Central requires beyond the normal build: source and javadoc jars,
             GPG signatures, and the upload to the Central Portal. Activate with -Prelease. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Kotlin sources: the javadoc jar Central requires is RENDERED by Dokka
                         (version and shared configuration from pluginManagement) but PACKAGED
                         by the jar plugin: Dokka's own javadocJar goal writes the build time
                         into every zip entry and the build user and JDK into the manifest,
                         ignoring project.build.outputTimestamp, so two builds of one tag never
                         matched. Rendering into a directory and letting the Maven archiver jar
                         it gives the javadoc jar the same reproducibility as the main and
                         sources jars (Dokka's rendered output itself is deterministic). On the
                         root POM nothing is rendered and skipIfEmpty attaches no empty jar - as
                         before, Central holds only the .pom for it. -->
                    <plugin>
                        <groupId>org.jetbrains.dokka</groupId>
                        <artifactId>dokka-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>render-javadoc</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>javadoc</goal>
                                </goals>
                                <configuration>
                                    <!-- Separate from the HTML site output in target/dokka. -->
                                    <outputDir>${project.build.directory}/dokka-javadoc</outputDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.build.directory}/dokka-javadoc</classesDirectory>
                                    <skipIfEmpty>true</skipIfEmpty>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- The build-only modules are no artefacts of the library. -->
                            <excludeArtifacts>
                                <artifact>veredium-coverage</artifact>
                                <artifact>veredium-test-support</artifact>
                                <artifact>veredium-examples</artifact>
                            </excludeArtifacts>
                            <!-- Uploads and validates the bundle but waits for a manual "Publish"
                                 click in the Central Portal; set to true for hands-off releases. -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
