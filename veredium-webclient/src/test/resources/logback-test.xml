<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- legatium's exchange events carry their data in two places a plain %msg pattern would hide: the
         adapter_* key-value pairs (SLF4J fluent API, rendered by %kvp - NONE = unquoted values) and the
         MDC trace keys, rendered by %mdc as key=value pairs - only the keys that are actually present.
         The restclient module's test configuration uses the same pattern. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg %kvp{NONE} [%mdc]%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
