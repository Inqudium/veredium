<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>veredium</artifactId>
        <version>${revision}</version>
    </parent>

    <!--
        The reactive client: a resilience-wrapped, mesh-configured client per backend, built on Spring's
        WebClient over Reactor Netty, with suspend-friendly call sites. The blocking sibling is
        veredium-restclient; veredium-restclient/docs/restclient-vs-webclient.md records what maps one-to-one
        and what deliberately differs.
    -->
    <artifactId>veredium-webclient</artifactId>
    <name>veredium-webclient</name>
    <description>Veredium reactive client: Spring WebClient over Reactor Netty with the mesh timeout ladder and Resilience4j</description>
    <!-- Explicit, so the published POM carries the homepage itself. -->
    <url>https://github.com/Inqudium/veredium</url>

    <dependencies>
        <!-- The stack-neutral core: the mesh timeout ladder, the breaker verdicts and the Resilience4j customizer wiring
             this module feeds with its own exception vocabulary (WebClientVerdicts). -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>veredium-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!--
            Boot 4 ships the WebClient auto-configuration as its own module with its own starter; starter-webflux
            does NOT pull it in. ResilientWebClientFactory takes Boot's WebClient.Builder bean as a REQUIRED
            constructor parameter, so the module that demands the bean brings the dependency that provides it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- The Spring Boot 4 auto-configuration of the three Resilience4j registries the decorator reads, and the
             Reactor operators that wrap a Mono. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-reactor</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            The non-default HTTP engines (app.webclient.engine.*). OPTIONAL on purpose: Reactor Netty, the default
            engine, comes with starter-webflux; a host that selects another engine adds that engine's library
            itself, and the factory fails the start naming these coordinates when it is missing. Versions from the
            Spring Boot BOM. On the test classpath because the engine tests drive every engine.
        -->
        <!-- jetty: Spring's JettyClientHttpConnector over Jetty's HttpClient and its reactive adapter. -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-reactive-httpclient</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-client</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- apache: Spring's HttpComponentsClientHttpConnector over Apache HttpClient 5's async client. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5-reactive</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- One structured log event per outbound HTTP exchange, as an ExchangeFilterFunction on Boot's
             WebClient.Builder bean - the bean ResilientWebClientFactory clones per backend. -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>legatium-webclient-logging</artifactId>
            <version>${legatium.version}</version>
        </dependency>

        <!-- JUnit 5, AssertJ and the Boot test support, like the sibling projects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-slf4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
                <executions>
                    <!--
                        Two test JVMs, because the JDK HTTP client reads jdk.httpclient.allowRestrictedHeaders ONCE,
                        when its classes initialise. The main run starts with it set to `host`, the documented host
                        setup for the jdk engine (every client of this module sends a Host header), so the jdk engine
                        is tested like the others. The second run starts WITHOUT it and holds only the test that pins
                        the startup failure a host gets when it selects jdk and forgot the flag. Production code never
                        sets the property: it is JVM-wide and would change every other java.net.http client.
                    -->
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/JdkEngineRestrictedHostHeaderTest*</exclude>
                            </excludes>
                            <systemPropertyVariables>
                                <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jdk-restricted-host-header</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes combine.self="override">
                                <include>**/JdkEngineRestrictedHostHeaderTest*</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- The module page Dokka renders on the API-reference index; version,
                 sourceLinks and failOnWarning come from the parent's pluginManagement.
                 No executions: dokka:dokka is invoked on demand by the Docs workflow. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>${project.basedir}/docs/api-module.md</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
