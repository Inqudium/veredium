<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>eu.inqudium</groupId>
        <artifactId>veredium</artifactId>
        <version>${revision}</version>
    </parent>

    <!--
        The blocking client: a resilience-wrapped, mesh-configured client per backend, built on Spring's
        RestClient over Apache HttpClient 5 by default, or over the JDK client, Jetty or Reactor Netty per
        app.restclient.engine. No reactive dependency on a consumer's classpath - that is the point of the
        module; Reactor Netty is an OPTIONAL dependency a host adds only to select that engine.
        docs/restclient-vs-webclient.md records what maps one-to-one to the reactive sibling veredium-webclient
        and what deliberately differs.
    -->
    <artifactId>veredium-restclient</artifactId>
    <name>veredium-restclient</name>
    <description>Veredium blocking client: Spring RestClient over Apache HttpClient 5 (or the JDK client, Jetty, Reactor Netty) with the mesh timeout ladder and Resilience4j</description>
    <!-- Explicit, so the published POM carries the homepage itself. -->
    <url>https://github.com/Inqudium/veredium</url>

    <dependencies>
        <!-- The stack-neutral core: the mesh timeout ladder, the breaker verdicts and the Resilience4j customizer wiring
             this module feeds with its own exception vocabulary (RestClientVerdicts). -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>veredium-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!--
            Boot's RestClient auto-configuration and its starter. ResilientRestClientFactory takes Boot's
            RestClient.Builder bean as a REQUIRED constructor parameter, so the module that demands the bean
            brings the dependency that provides it. Version from the parent BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!--
            The default transport. Apache HttpClient 5 is the one blocking engine Spring supports whose connection
            POOL has every knob the mesh transport config expresses (max connections, pending-acquire timeout,
            idle and lifetime eviction) - hence the default, and a regular dependency. Version from the Boot BOM.
        -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <!-- Apache's own Micrometer integration for the transport: the pool gauges (ConnPoolMeters). -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5-observation</artifactId>
        </dependency>
        <!--
            The two selectable engines that need a library (app.restclient.engine; the JDK engine needs none).
            OPTIONAL: a consumer gets neither transitively, so its classpath stays as it was - no Jetty, and no
            reactive artifact - until it selects the engine and adds the dependency itself; the factory fails the
            start naming these coordinates when an engine is selected without its library. Here for compilation
            and for the tests, which run every engine. Versions from the Boot BOM.
        -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-client</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty-http</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Bean Validation API and an implementation, so a host's response DTO constraints can be evaluated. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- The Spring Boot 4 auto-configuration of the three Resilience4j registries the decorator reads. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- MeterRegistry and ObservationRegistry, both optional collaborators of the factory. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            One structured log event per outbound HTTP exchange (logger `adapter-http-exchange`, the adapter_*
            field family). Its auto-configuration hangs an interceptor on every builder that comes out of Boot's
            RestClient.Builder bean - the bean ResilientRestClientFactory clones per backend.
        -->
        <dependency>
            <groupId>eu.inqudium</groupId>
            <artifactId>legatium-restclient-logging</artifactId>
            <version>${legatium.version}</version>
        </dependency>

        <!-- JUnit 5, AssertJ and the Boot test support, like the sibling projects. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Micrometer Tracing API, TEST ONLY: legatium decides its traced/untraced wiring verdict by looking up a
             bean of type io.micrometer.tracing.Tracer; the integration test pins both branches with Tracer.NOOP. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jazzer's JUnit 5 integration for the @FuzzTest targets under src/test/java (CONTRIBUTING.md
             "Fuzzing"); version and test scope managed in the parent. -->
        <dependency>
            <groupId>com.code-intelligence</groupId>
            <artifactId>jazzer-junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- The Jazzer @FuzzTest targets are Java sources under src/test/java (CONTRIBUTING.md "Fuzzing");
                 the parent-managed execution adds that directory as a second test-source root next to
                 src/test/kotlin. They call the Kotlin main classes only, which are compiled by then. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- Skip repackaging - we're a library, not a standalone app -->
                </configuration>
            </plugin>
            <!-- The module page Dokka renders on the API-reference index; version,
                 sourceLinks and failOnWarning come from the parent's pluginManagement.
                 No executions: dokka:dokka is invoked on demand by the Docs workflow. -->
            <plugin>
                <groupId>org.jetbrains.dokka</groupId>
                <artifactId>dokka-maven-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>${project.basedir}/docs/api-module.md</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
