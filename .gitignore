# Maven build output
target/

# MkDocs build output
site/

# Generated by .github/scripts/generate-test-catalog.py (Docs workflow);
# never checked in - it would be a drifting copy of the Surefire results.
docs/tests/

# Generated by .github/scripts/generate-guide-pages.py (Docs workflow);
# never checked in - it would be a drifting copy of the module guides.
docs/guides/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/
/.idea/

# Working corpus of local JAZZER_FUZZ=1 runs (jazzer-junit); regenerated on
# every fuzzing run - only FINDINGS (seed inputs under src/test/resources)
# are versioned.
.cifuzz-corpus/
